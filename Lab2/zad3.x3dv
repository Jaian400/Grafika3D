ROUTE TimerSun.fraction_changed TO SunOInter.set_fraction
ROUTE SunOInter.value_changed TO SUN.set_rotation

ROUTE TimerMercury.fraction_changed TO MercuryOInter.set_fraction
ROUTE TimerMercury2.fraction_changed TO MercuryOInter2.set_fraction
ROUTE MercuryOInter.value_changed TO MercuryOrbit.set_rotation

ROUTE TimerVenus.fraction_changed TO VenusOInter.set_fraction
ROUTE TimerVenus2.fraction_changed TO VenusOInter2.set_fraction
ROUTE VenusOInter.value_changed TO VenusOrbit.set_rotation

ROUTE TimerEarth.fraction_changed TO EarthOInter.set_fraction
ROUTE TimerEarth2.fraction_changed TO EarthOInter2.set_fraction
ROUTE EarthOInter.value_changed TO EarthOrbit.set_rotation

ROUTE TimerMars.fraction_changed TO MarsOInter.set_fraction
ROUTE TimerMars2.fraction_changed TO MarsOInter2.set_fraction
ROUTE MarsOInter.value_changed TO MarsOrbit.set_rotation

ROUTE TimerJupter.fraction_changed TO JupiterOInter.set_fraction
ROUTE TimerJupter2.fraction_changed TO JupiterOInter2.set_fraction
ROUTE JupiterOInter.value_changed TO JupiterOrbit.set_rotation

ROUTE TimerSaturn.fraction_changed TO SaturnOInter.set_fraction
ROUTE TimerSaturn2.fraction_changed TO SaturnOInter2.set_fraction
ROUTE SaturnOInter.value_changed TO SaturnOrbit.set_rotation

ROUTE TimerUranus.fraction_changed TO UranusOInter.set_fraction
