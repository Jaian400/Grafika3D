#X3D V3.3 utf8D

DEF SUN Transform {
    children Shape {
        appearance Appearance {
            texture ImageTexture {
                url "textures/sun.jpg"
            }
            material Material {
            }
        }
        geometry Sphere {
            radius 10
        }
    }
}

DEF TimerSun TimeSensor { 
    cycleInterval 80
    loop TRUE 
}

DEF TimerMercury TimeSensor { 
    cycleInterval 5
    loop TRUE 
}

DEF TimerMercury2 TimeSensor { 
    cycleInterval 20
    loop TRUE 
}

DEF TimerVenus TimeSensor { 
    cycleInterval 10
    loop TRUE 
}

DEF TimerVenus2 TimeSensor { 
    cycleInterval 10
    loop TRUE 
}

DEF TimerEarth TimeSensor { 
    cycleInterval 15
    loop TRUE 
}

DEF TimerEarth2 TimeSensor { 
    cycleInterval 1
    loop TRUE 
}

DEF TimerMars TimeSensor { 
    cycleInterval 17
    loop TRUE 
}

DEF TimerMars2 TimeSensor { 
    cycleInterval 17
    loop TRUE 
}

DEF TimerJupter TimeSensor { 
    cycleInterval 28
    loop TRUE 
}

DEF TimerJupter2 TimeSensor { 
    cycleInterval 1000
    loop TRUE 
}

DEF TimerSaturn TimeSensor { 
    cycleInterval 40
    loop TRUE 
}

DEF TimerSaturn2 TimeSensor { 
    cycleInterval 4
    loop TRUE 
}

DEF TimerUranus TimeSensor { 
    cycleInterval 54
    loop TRUE 
}

DEF TimerUranus2 TimeSensor { 
    cycleInterval 54
    loop TRUE 
}

DEF TimerNeptune TimeSensor { 
    cycleInterval 70
    loop TRUE 
}

DEF TimerNeptune2 TimeSensor { 
    cycleInterval 70
    loop TRUE 
}

PROTO OInter [
    inputOnly  SFFloat    set_fraction
    outputOnly SFRotation value_changed     
] {
    OrientationInterpolator {
        set_fraction  IS set_fraction      
        value_changed IS value_changed
        key [0 0.5 1]
        keyValue [
            0 1 0 0
            0 1 0 3.14
            0 1 0 6.28
        ]
    }
}

PROTO Planet [
    inputOutput SFRotation rot 0 1 0 0
    field SFVec3f pos 15 0 0
    field MFString tex "textures/sun.jpg"
    field SFFloat r 1
] {
    Transform {
        translation IS pos
        rotation IS rot
        children Shape {
            appearance Appearance {
                texture ImageTexture {
                    url IS tex
                }
            }
            geometry Sphere {
                radius IS r
            }
        }
    }
}

DEF MercuryOrbit Transform {
    children DEF MERCURY Planet {
        pos 15 0 0
        r 0.6
        tex "textures/2k_mercury.jpg"
    }
}

DEF VenusOrbit Transform {
    children DEF VENUS Planet {
        pos 20 0 0
        r 0.8
        tex "textures/2k_venus_atmosphere.jpg"
    }
}

DEF EarthOrbit Transform {
    children DEF EARTH Planet {
        pos 25 0 0
        r 1
        tex "textures/2k_earth_daymap.jpg"
    }
}

DEF MarsOrbit Transform {
    children DEF MARS Planet {
        pos 30 0 0
        r 1
        tex "textures/2k_mars.jpg"
    }
}

DEF JupiterOrbit Transform {
    children DEF JUPITER Planet {
        pos 40 0 0
        r 2.5
        tex "textures/2k_jupiter.jpg"
    }
}

DEF SaturnOrbit Transform {
    children [
        DEF SATURN Planet {
            pos 48 0 0
            r 2.1
            tex "textures/2k_saturn.jpg"
        }
        Transform {
            translation 48 0 0
            children Shape {
                appearance Appearance {
                    texture ImageTexture {
                        url "textures/2k_saturn_ring_alpha.png"
                    }
                }
                geometry Cylinder {
                    height 0.0001
                    radius 3
                }
            }
        }
    ]
}

DEF UranusOrbit Transform {
    children DEF URANUS Planet {
        pos 56 0 0
        r 1.9
        tex "textures/2k_uranus.jpg"
    }
}

DEF NeptuneOrbit Transform {
    children DEF NEPTUNE Planet {
        pos 64 0 0
        r 1.8
        tex "textures/2k_neptune.jpg"
    }
}

