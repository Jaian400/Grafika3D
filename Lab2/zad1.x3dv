#X3D V3.3 utf8D

DEF Sfera Transform {
    translation 4 0 0
    children Shape {
        appearance Appearance {
            material Material {
                emissiveColor 0 1 0
                transparency 0.6
                specularColor 0 1 0
                shininess 1
            }
        }
        geometry Sphere {
            radius 1
        }
    }
}

DEF Szescian Transform {
    children Shape {
        appearance Appearance {
            material Material {
                emissiveColor 0 0 1
                transparency 0.6
                specularColor 0 0 1
                shininess 1
            }
        }
        geometry Box {
            radius 1
        }
    }
}

DEF Timer TimeSensor {
  cycleInterval 5
  loop TRUE
}

DEF OInter OrientationInterpolator {
    key [0 0.5 1]
    keyValue [
        0 1 0 0
        0 1 0 3.14
        0 1 0 6.28
    ]
}

DEF PInter PositionInterpolator {
    key [0 0.25 0.5 0.75 1]
    keyValue [
        4 0 0
        0 0 4
        -4 0 0
        0 0 -4
        4 0 0
    ]
}

ROUTE Timer.fraction_changed TO OInter.set_fraction
ROUTE OInter.value_changed TO Szescian.set_rotation

ROUTE Timer.fraction_changed TO PInter.set_fraction
ROUTE PInter.value_changed TO Sfera.set_translation