#   intensity 0.6
#   color 1 1 1
# }

Transform {
  translation 0 0 0
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.2 0.2 0.2 }
      }
      geometry Box { size 20 0.2 20 }
    }
  ]
}

DEF MatSciany Appearance {
  material Material { diffuseColor 0.5 0.5 0.5 }
}

DEF ScianaKrotka Shape {
  appearance USE MatSciany
  geometry Box { size 4 4 1 }
}

DEF ScianaDluga Shape {
  appearance USE MatSciany
  geometry Box { size 8 4 1 }
}

Group {
  children [
    Transform {
      translation 0 2 -10
      children [ USE ScianaDluga ]
    }
    Transform {
      translation 7 2 -10
      children [ USE ScianaDluga ]
    }
    Transform {
      translation -7 2 -10
      children [ USE ScianaDluga ]
    }

    Transform {
      translation -10 2 0
      rotation 0 1 0 1.5708
      children [ USE ScianaDluga ]
    }
    Transform {
      translation -10 2 -5
      rotation 0 1 0 1.5708
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation -10 2 7
      rotation 0 1 0 1.5708
      children [ USE ScianaDluga ]
    }

    Transform {
      translation 3 2 10
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation -3 2 10
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation 7 2 10
      children [ USE ScianaDluga ]
    }
    Transform {
      translation -7 2 10
      children [ USE ScianaDluga ]
    }

    Transform {
      translation 10 2 0
      rotation 0 1 0 1.5708
      children [ USE ScianaDluga ]
    }
    Transform {
      translation 10 2 -7
      rotation 0 1 0 1.5708
      children [ USE ScianaDluga ]
    }
    Transform {
      translation 10 2 7
      rotation 0 1 0 1.5708
      children [ USE ScianaDluga ]
    }
  ]
}

Group {
  children [
    Transform {
      translation 5 2 0
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation -5 2 0
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation 0 2 0
      children [ USE ScianaDluga ]
    }
    
    Transform {
      translation 0 2 -6
      children [ USE ScianaDluga ]
    }
    Transform {
      translation 6 2 -3
      children [ USE ScianaDluga ]
    }
    Transform {
      translation -6 2 -3
      children [ USE ScianaDluga ]
    }
    Transform {
      translation -3 2 -3
      children [ USE ScianaKrotka ]
    }

    Transform {
      translation 5 2 -6
      children [ USE ScianaKrotka ]
    }
    
    Transform {
      translation -6 2 -6
      children [ USE ScianaDluga ]
    }
    
    Transform {
      translation 0 2 6
      children [ USE ScianaDluga ]
    }
    Transform {
      translation -5 2 6
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation 5 2 6
      children [ USE ScianaKrotka ]
    }

    Transform {
      translation 0 2 3
      children [ USE ScianaKrotka ]
    }
    Transform {
      translation -6 2 3
      children [ USE ScianaDluga ]
    }
    Transform {
      translation 7.5 2 3
      children [ USE ScianaKrotka ]
    }
  ]
}

DEF DrzwiTransform Transform {
  translation 0 1.5 10
  center -1 0 0   
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.5 0.25 0.1 } 
      }
      geometry Box { size 2 2.9 0.1 }
    }
  ]
}

Transform {
  translation 2 2 10.5
  children [
    DEF PrzyciskSensor TouchSensor {
    }
    Transform {
      translation 0 0 0.05
      children [
        Shape {
          appearance Appearance {
            material Material { diffuseColor 1 0 0 }
          }
          geometry Box { size 1 1 0.5 }
        }
      ]
    }
  ]
}

DEF ZegarDrzwi TimeSensor {
  cycleInterval 6
  loop FALSE
}

DEF InterpDrzwi OrientationInterpolator {
  key [ 0, 0.3, 0.7, 1 ]
  keyValue [
    0 1 0  0.0,
    0 1 0 -1.57,
    0 1 0 -1.57,
    0 1 0  0.0
  ]
}

ROUTE PrzyciskSensor.touchTime TO ZegarDrzwi.set_startTime
ROUTE ZegarDrzwi.fraction_changed TO InterpDrzwi.set_fraction
ROUTE InterpDrzwi.value_changed TO DrzwiTransform.set_rotation